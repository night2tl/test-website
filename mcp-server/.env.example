# Base URL of the upstream API (required)
API_BASE_URL=http://localhost:4000

# Authentication mode: "none" (default), "service-token", or "passthrough"
AUTH_MODE=none

# Static bearer token (required for service-token mode or passthrough over stdio)
# API_AUTH_TOKEN=

# HTTP header name used to send the credential (default: "authorization")
# API_AUTH_HEADER=authorization

# Scheme prefix for the token (default: "Bearer"; set to "" to send raw token)
# API_AUTH_SCHEME=Bearer

# OAuth issuer URL (required for passthrough mode over HTTP)
# AUTH_ISSUER=

# Public URL of this MCP server (required for passthrough mode over HTTP)
# MCP_PUBLIC_URL=

# Port the HTTP server listens on (default: 3000)
PORT=3000
