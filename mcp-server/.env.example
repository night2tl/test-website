# Base URL of the upstream API
API_BASE_URL=http://localhost:4000

# Auth mode: "service-token" (default), "passthrough", or "none"
AUTH_MODE=service-token

# Credential sent to the API (required for service-token mode)
API_AUTH_TOKEN=

# Header name used for the credential (default: "authorization")
API_AUTH_HEADER=x-api-key

# Scheme prefix before the token (default: "Bearer"); leave empty for raw key
API_AUTH_SCHEME=

# Value for the x-api-key header (used when API_AUTH_HEADER is not already x-api-key)
API_HEADER_X_API_KEY=

# OAuth issuer URL (required for passthrough mode over HTTP)
# AUTH_ISSUER=

# Public URL of this MCP server (required for passthrough mode over HTTP)
# MCP_PUBLIC_URL=

# HTTP listen port (default: 3000)
# PORT=3000
