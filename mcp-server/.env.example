# Base URL of the upstream API
API_BASE_URL=http://localhost:4000

# Auth mode: "service-token" (default), "passthrough", or "none"
AUTH_MODE=service-token

# Credential sent to the API (required for service-token mode)
API_AUTH_TOKEN=

# Header name and scheme for the API credential
API_AUTH_HEADER=x-api-key
API_AUTH_SCHEME=

# x-api-key header value sent with every API request (API key for authentication)
API_HEADER_X_API_KEY=

# Shared secret clients must send as Authorization: Bearer <token> to /mcp (min 16 chars)
MCP_INBOUND_TOKEN=

# Set to "true" to run without MCP_INBOUND_TOKEN
MCP_ALLOW_UNAUTHENTICATED=false

# Required for passthrough mode
# AUTH_ISSUER=https://your-issuer.example.com
# MCP_PUBLIC_URL=http://localhost:3000

# HTTP listen port
PORT=3000
