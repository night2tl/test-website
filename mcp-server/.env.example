# Base URL of the upstream API
API_BASE_URL=http://localhost:4000

# Auth mode: "none" (default), "passthrough", or "service-token"
AUTH_MODE=none

# Bearer token sent to the upstream API (required for service-token mode)
API_AUTH_TOKEN=

# Header name for the credential (default: authorization)
API_AUTH_HEADER=authorization

# Scheme prefix for the token (default: Bearer)
API_AUTH_SCHEME=Bearer

# OAuth issuer URL (required for passthrough mode over HTTP)
AUTH_ISSUER=

# Public URL of this MCP server (required for passthrough mode over HTTP)
MCP_PUBLIC_URL=

# Shared secret (>= 16 chars) for protecting the /mcp endpoint over HTTP
MCP_INBOUND_TOKEN=

# Set to "true" to allow unauthenticated HTTP access (not recommended for production)
MCP_ALLOW_UNAUTHENTICATED=false

# HTTP listen port (default: 3000)
PORT=3000
