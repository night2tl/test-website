# Base URL of the upstream API
API_BASE_URL=http://localhost:4000

# Authentication mode: "none" | "passthrough" | "service-token"
AUTH_MODE=none

# Static bearer token (required for service-token mode)
# API_AUTH_TOKEN=your-token-here

# Header name used to send the credential (default: authorization)
# API_AUTH_HEADER=authorization

# Scheme prefix for the credential (default: Bearer; set to empty to send raw token)
# API_AUTH_SCHEME=Bearer

# OAuth issuer URL (required for passthrough mode over HTTP)
# AUTH_ISSUER=https://auth.example.com

# Public URL of this MCP server (required for passthrough mode over HTTP)
# MCP_PUBLIC_URL=http://localhost:3000

# Port the HTTP server listens on
PORT=3000
